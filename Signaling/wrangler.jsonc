{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "farreach-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "DEVICES", "class_name": "DeviceMailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceMailbox"] }],
  "ratelimits": [{
    "name": "CONNECTION_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
